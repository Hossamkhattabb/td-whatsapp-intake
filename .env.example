# Copy to .env for local development only. Never commit .env.
# On Render, set these in the service's Environment settings instead.
# PORT is set by Render automatically; locally it defaults to 3000.

META_VERIFY_TOKEN=choose-a-random-string
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
RESEND_API_KEY=re_xxxxxxxx
# Optional: sender on a domain verified in Resend
# EMAIL_FROM=Top Delmon <hello@your-domain.com>
